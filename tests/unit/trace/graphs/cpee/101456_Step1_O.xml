<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Identify personal data breach</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <choose mode="exclusive" a:alt_id="2">
    <alternative condition="Breach likely to result in risk" language="text/javascript">
      <call id="a5" endpoint="" a:alt_id="3">
        <parameters>
          <label>Notify supervisory authority within 72 hours</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <choose mode="exclusive" a:alt_id="5">
        <alternative condition="Notification made within 72 hours" language="text/javascript">
          <call id="a11" endpoint="" a:alt_id="6">
            <parameters>
              <label>Provide details of the breach</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
        <alternative condition="Notification not made within 72 hours" language="text/javascript">
          <call id="a13" endpoint="" a:alt_id="7">
            <parameters>
              <label>Provide reasons for delay and details of the breach</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
      </choose>
      <call id="a15" endpoint="" a:alt_id="8">
        <parameters>
          <label>Document the breach and remedial action</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <choose mode="exclusive" a:alt_id="9">
        <alternative condition="Breach likely to result in high risk" language="text/javascript">
          <call id="a21" endpoint="" a:alt_id="10">
            <parameters>
              <label>Communicate the breach to the data subject</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
        <alternative condition="Breach unlikely to result in high risk" language="text/javascript"/>
      </choose>
    </alternative>
    <alternative condition="Breach unlikely to result in risk" language="text/javascript"/>
  </choose>
</description>