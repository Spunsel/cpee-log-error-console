<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <loop mode="pre_test" condition="true">
    <call id="a1" endpoint="" a:alt_id="1">
      <parameters>
        <label>Find Property</label>
        <method/>
        <type>:task</type>
        <arguments/>
      </parameters>
    </call>
    <call id="a3" endpoint="" a:alt_id="2">
      <parameters>
        <label>Schedule Viewing</label>
        <method/>
        <type>:task</type>
        <arguments/>
      </parameters>
    </call>
    <loop mode="pre_test" condition="Property Suitable">
      <choose mode="exclusive" a:alt_id="3">
        <alternative condition="Property Suitable" language="text/javascript">
          <call id="a7" endpoint="" a:alt_id="4">
            <parameters>
              <label>Submit Application</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <call id="a11" endpoint="" a:alt_id="5">
            <parameters>
              <label>Landlord Review</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <choose mode="exclusive" a:alt_id="6">
            <alternative condition="Application Rejected" language="text/javascript">
              <call id="a1" endpoint="" a:alt_id="1">
                <parameters>
                  <label>Find Property</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
              <call id="a3" endpoint="" a:alt_id="2">
                <parameters>
                  <label>Schedule Viewing</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
            </alternative>
            <alternative condition="Application Approved" language="text/javascript">
              <call id="a15" endpoint="" a:alt_id="7">
                <parameters>
                  <label>Sign Lease</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
              <call id="a19" endpoint="" a:alt_id="8">
                <parameters>
                  <label>Pay Deposit</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
              <escape a:alt_id="-1"/>
            </alternative>
          </choose>
        </alternative>
        <alternative condition="Property Not Suitable" language="text/javascript">
          <call id="a1" endpoint="" a:alt_id="1">
            <parameters>
              <label>Find Property</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <call id="a3" endpoint="" a:alt_id="2">
            <parameters>
              <label>Schedule Viewing</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
      </choose>
    </loop>
  </loop>
</description>
