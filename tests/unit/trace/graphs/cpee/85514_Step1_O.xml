<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Personal Data Breach Occurs</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <call id="a3" endpoint="" a:alt_id="2">
    <parameters>
      <label>Processor Notifies Controller</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <call id="a5" endpoint="" a:alt_id="3">
    <parameters>
      <label>Controller Becomes Aware</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <choose mode="exclusive" a:alt_id="4">
    <alternative condition="Breach unlikely to result in a risk" language="text/javascript"/>
    <alternative condition="Breach likely to result in a risk" language="text/javascript">
      <call id="a11" endpoint="" a:alt_id="5">
        <parameters>
          <label>Notify Supervisory Authority</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <choose mode="exclusive" a:alt_id="6">
        <alternative condition="Notification within 72 hours" language="text/javascript"/>
        <alternative condition="Notification not within 72 hours" language="text/javascript">
          <call id="a17" endpoint="" a:alt_id="8">
            <parameters>
              <label>Provide reasons for the delay</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
      </choose>
      <call id="a15" endpoint="" a:alt_id="7">
        <parameters>
          <label>Describe the nature of the personal data breach</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <call id="a21" endpoint="" a:alt_id="9">
        <parameters>
          <label>Communicate contact details of DPO</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <call id="a23" endpoint="" a:alt_id="10">
        <parameters>
          <label>Describe likely consequences</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <call id="a25" endpoint="" a:alt_id="11">
        <parameters>
          <label>Describe measures taken</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <choose mode="exclusive" a:alt_id="12">
        <alternative condition="Information provided at the same time" language="text/javascript"/>
        <alternative condition="Information provided in phases" language="text/javascript">
          <call id="a31" endpoint="" a:alt_id="13">
            <parameters>
              <label>Provide information in phases</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
      </choose>
    </alternative>
  </choose>
  <call id="a9" endpoint="" a:alt_id="14">
    <parameters>
      <label>Document the personal data breach</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
</description>