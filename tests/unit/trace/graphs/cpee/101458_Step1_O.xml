<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Identify personal data breach</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <choose mode="exclusive" a:alt_id="2">
    <alternative condition="Breach identified by Controller" language="text/javascript"/>
    <alternative condition="Breach identified by Processor" language="text/javascript">
      <call id="a7" endpoint="" a:alt_id="4">
        <parameters>
          <label>Notify Controller without undue delay</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
    </alternative>
  </choose>
  <call id="a5" endpoint="" a:alt_id="3">
    <parameters>
      <label>Notify supervisory authority within 72 hours</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <choose mode="exclusive" a:alt_id="5">
    <alternative condition="Notification within 72 hours" language="text/javascript">
      <call id="a13" endpoint="" a:alt_id="6">
        <parameters>
          <label>Document the breach, its effects, and remedial action</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
    </alternative>
    <alternative condition="Notification after 72 hours" language="text/javascript">
      <call id="a15" endpoint="" a:alt_id="7">
        <parameters>
          <label>Provide reasons for delay and document the breach, its effects, and remedial action</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
    </alternative>
  </choose>
  <choose mode="exclusive" a:alt_id="8">
    <alternative condition="High risk to rights and freedoms" language="text/javascript">
      <call id="a21" endpoint="" a:alt_id="9">
        <parameters>
          <label>Communicate the breach to the data subject</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
    </alternative>
    <alternative condition="No high risk to rights and freedoms" language="text/javascript"/>
  </choose>
</description>