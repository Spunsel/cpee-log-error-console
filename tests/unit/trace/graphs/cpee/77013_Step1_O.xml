<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Request to lend the book</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <call id="a3" endpoint="" a:alt_id="2">
    <parameters>
      <label>Reply on the book status</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <choose mode="exclusive" a:alt_id="3">
    <alternative condition="Book is available" language="text/javascript">
      <call id="a7" endpoint="" a:alt_id="4">
        <parameters>
          <label>Submit the order to lend it</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <call id="a9" endpoint="" a:alt_id="5">
        <parameters>
          <label>Lending the book</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
    </alternative>
    <alternative condition="Book is unavailable/on loan" language="text/javascript">
      <choose mode="exclusive" a:alt_id="6">
        <alternative condition="On loan for 1 month" language="text/javascript">
          <call id="a15" endpoint="" a:alt_id="7">
            <parameters>
              <label>Cancel the request</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
        <alternative condition="On loan for 2 weeks" language="text/javascript">
          <call id="a19" endpoint="" a:alt_id="8">
            <parameters>
              <label>Request to hold the book</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <call id="a21" endpoint="" a:alt_id="9">
            <parameters>
              <label>Receive the availability of the book status</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <call id="a23" endpoint="" a:alt_id="10">
            <parameters>
              <label>Get the book</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <call id="a25" endpoint="" a:alt_id="11">
            <parameters>
              <label>Lent the book</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
        </alternative>
      </choose>
    </alternative>
  </choose>
</description>
