<description xmlns="http://cpee.org/ns/description/1.0" xmlns:a="http://cpee.org/ns/annotation/1.0">
  <call id="a1" endpoint="" a:alt_id="1">
    <parameters>
      <label>Become Aware of Data Breach</label>
      <method/>
      <type>:task</type>
      <arguments/>
    </parameters>
  </call>
  <choose mode="exclusive" a:alt_id="0">
    <alternative condition="">
      <choose mode="exclusive" a:alt_id="2">
        <alternative condition="Risk Unlikely" language="text/javascript"/>
        <alternative condition="Risk Likely" language="text/javascript">
          <call id="a7" endpoint="" a:alt_id="3">
            <parameters>
              <label>Notify Supervisory Authority</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <choose mode="exclusive" a:alt_id="4">
            <alternative condition="Within 72 Hours" language="text/javascript"/>
            <alternative condition="After 72 Hours" language="text/javascript">
              <call id="a13" endpoint="" a:alt_id="5">
                <parameters>
                  <label>Provide Reasons for Delay</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
            </alternative>
          </choose>
          <call id="a11" endpoint="" a:alt_id="12">
            <parameters>
              <label>Describe Breach Details</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <choose mode="exclusive" a:alt_id="14">
            <alternative condition="All Info Available" language="text/javascript"/>
            <alternative condition="Info in Phases" language="text/javascript">
              <call id="a21" endpoint="" a:alt_id="13">
                <parameters>
                  <label>Provide Information in Phases</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
