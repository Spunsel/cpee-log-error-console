          <label>Document Data Breach</label>
          <method/>
          <type>:task</type>
          <arguments/>
        </parameters>
      </call>
      <choose mode="exclusive" a:alt_id="15">
        <alternative condition="High Risk" language="text/javascript">
          <call id="a29" endpoint="" a:alt_id="8">
            <parameters>
              <label>Communicate to Data Subject</label>
              <method/>
              <type>:task</type>
              <arguments/>
            </parameters>
          </call>
          <choose mode="exclusive" a:alt_id="9">
            <alternative condition="Protection Measures" language="text/javascript">
              <call id="a35" endpoint="" a:alt_id="16">
                <parameters>
                  <label>Implement Protection Measures</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
              <choose mode="exclusive" a:alt_id="19">
                <alternative condition="Risk Mitigated" language="text/javascript"/>
                <alternative condition="Risk Persists" language="text/javascript">
                  <call id="a51" endpoint="" a:alt_id="20">
                    <parameters>
                      <label>Supervisory Authority Decision</label>
                      <method/>
                      <type>:task</type>
                      <arguments/>
                    </parameters>
                  </call>
                </alternative>
              </choose>
            </alternative>
            <alternative condition="Subsequent Measures" language="text/javascript">
              <call id="a37" endpoint="" a:alt_id="17">
                <parameters>
                  <label>Take Subsequent Measures</label>
                  <method/>
                  <type>:task</type>
                  <arguments/>
                </parameters>
              </call>
              <choose mode="exclusive" a:alt_id="19">
                <alternative condition="Risk Mitigated" language="text/javascript"/>
                <alternative condition="Risk Persists" language="text/javascript">
                  <call id="a51" endpoint="" a:alt_id="20">
                    <parameters>
                      <label>Supervisory Authority Decision</label>
                      <method/>
                      <type>:task</type>
                      <arguments/>
                    </parameters>
